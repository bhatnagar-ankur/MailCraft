{
  "name": "@bhatnagar-ankur/mailcraft-core",
  "version": "0.1.4",
  "description": "Core rendering engine for MailCraft — MJML compiler, Handlebars renderer, and CSS inliner",
  "keywords": ["email", "mjml", "handlebars", "template", "transactional", "html-email", "outlook", "mailcraft"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhatnagar-ankur/MailCraft.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/bhatnagar-ankur/MailCraft#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mailcraft": "dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js && node scripts/generate-previews.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bhatnagar-ankur/mailcraft-types": "workspace:*",
    "commander": "^12.1.0",
    "handlebars": "^4.7.8",
    "juice": "^11.0.0",
    "mjml": "^4.15.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mjml": "^4.7.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
