{
  "id": "welcome",
  "name": "HR Welcome / Onboarding Email",
  "description": "New employee first-day welcome with full joining details in a structured table",
  "useCase": "HR onboarding, client welcome, new hire joining letter",
  "variables": {
    "firstName":          { "type": "string", "required": true,  "description": "Employee's first name" },
    "lastName":           { "type": "string", "required": true,  "description": "Employee's last name" },
    "workEmail":          { "type": "string", "required": true,  "description": "Corporate / work email address assigned to the employee" },
    "companyName":        { "type": "string", "required": true,  "description": "Company or organisation name" },
    "role":               { "type": "string", "required": true,  "description": "Job title or role" },
    "startDate":          { "type": "string", "required": true,  "description": "First day date, e.g. 'September 15, 2026'" },
    "employeeId":         { "type": "string", "required": false, "description": "Employee ID or staff number" },
    "personalEmail":      { "type": "string", "required": false, "description": "Personal email address of the employee" },
    "department":         { "type": "string", "required": false, "description": "Department name, e.g. 'Engineering'" },
    "team":               { "type": "string", "required": false, "description": "Team name within the department" },
    "managerName":        { "type": "string", "required": false, "description": "Reporting manager's full name" },
    "workLocation":       { "type": "string", "required": false, "description": "Office location or 'Remote'" },
    "previousExperience": { "type": "string", "required": false, "description": "Relevant prior experience, e.g. '6 years in backend engineering'" },
    "employmentType":     { "type": "string", "required": false, "description": "Employment type, e.g. 'Full-time', 'Contract'" },
    "workingHours":       { "type": "string", "required": false, "description": "Working hours, e.g. '9:00 AM – 6:00 PM IST'" },
"reportingLocation":  { "type": "string", "required": false, "description": "Where to report on day 1, e.g. 'Floor 4, HQ — ask for Jane at reception'" },
    "reportingTime":      { "type": "string", "required": false, "description": "Time to report on day 1, e.g. '9:30 AM'" },
    "hrEmail":            { "type": "string", "required": false, "description": "HR contact email address" },
    "itSetupLink":        { "type": "url",    "required": false, "description": "Link to the IT setup / equipment guide" },
    "onboardingNote":     { "type": "string", "required": false, "description": "Optional custom note from HR shown as a highlighted callout" },
    "portalLink":         { "type": "url",    "required": false, "description": "Onboarding portal or HRMS link" },
    "logoUrl":            { "type": "url",    "required": false, "description": "Company logo image URL" }
  }
}
