<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Inter', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#374151" padding="0 0 16px 0" />
      <mj-button font-size="16px" font-weight="600" border-radius="6px" inner-padding="14px 28px" />
    </mj-attributes>
    <mj-preview>Welcome to {{companyName}}, {{firstName}}!</mj-preview>
  </mj-head>
  <mj-body background-color="#f3f4f6">

    <mj-section padding="24px 0 0 0">
      <mj-column><mj-spacer height="4px" /></mj-column>
    </mj-section>

    <!-- Header -->
    <mj-section background-color="#1e40af" padding="32px 40px" border-radius="8px 8px 0 0">
      <mj-column>
        <mj-text align="center" font-size="26px" font-weight="700" color="#ffffff" padding="0">
          Welcome to {{companyName}}! 🎉
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Greeting -->
    <mj-section background-color="#ffffff" padding="32px 40px 0">
      <mj-column>
        <mj-text font-size="18px" color="#111827" padding="0 0 12px 0">Hi {{firstName}},</mj-text>
        <mj-text padding="0">
          We're thrilled to have you joining us as <strong>{{role}}</strong>. Your first day is
          <strong>{{startDate}}</strong> and we can't wait to welcome you to the team.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Info cards -->
    <mj-section background-color="#ffffff" padding="24px 40px">
      <mj-column border="1px solid #e5e7eb" border-radius="6px" padding="16px">
        <mj-text font-size="11px" font-weight="700" color="#6b7280" padding="0 0 4px 0">ROLE</mj-text>
        <mj-text font-size="17px" font-weight="600" color="#111827" padding="0">{{role}}</mj-text>
      </mj-column>
      <mj-column border="1px solid #e5e7eb" border-radius="6px" padding="16px">
        <mj-text font-size="11px" font-weight="700" color="#6b7280" padding="0 0 4px 0">START DATE</mj-text>
        <mj-text font-size="17px" font-weight="600" color="#111827" padding="0">{{startDate}}</mj-text>
      </mj-column>
      <mj-column border="1px solid #e5e7eb" border-radius="6px" padding="16px">
        <mj-text font-size="11px" font-weight="700" color="#6b7280" padding="0 0 4px 0">MANAGER</mj-text>
        <mj-text font-size="17px" font-weight="600" color="#111827" padding="0">{{managerName}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section background-color="#ffffff" padding="0 40px 32px">
      <mj-column>
        <mj-button background-color="#1e40af" color="#ffffff" href="{{portalLink}}" align="center">
          Access Your Portal
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f9fafb" border-radius="0 0 8px 8px" padding="20px 40px">
      <mj-column>
        <mj-text font-size="13px" color="#9ca3af" align="center" padding="0">
          © {{companyName}} · All rights reserved
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 0 24px 0">
      <mj-column><mj-spacer height="4px" /></mj-column>
    </mj-section>

  </mj-body>
</mjml>
