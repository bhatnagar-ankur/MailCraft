<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Inter', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" />
      <mj-text font-size="15px" line-height="1.6" color="#374151" padding="0 0 14px 0" />
      <mj-button font-size="15px" font-weight="600" border-radius="6px" inner-padding="13px 28px" />
    </mj-attributes>
    <mj-preview>Welcome to {{companyName}}, {{firstName}}! Your joining details inside.</mj-preview>
  </mj-head>
  <mj-body background-color="#f1f5f9">

    <mj-section padding="28px 0 0 0">
      <mj-column><mj-spacer height="4px" /></mj-column>
    </mj-section>

    <!-- Header -->
    <mj-section background-color="#1e40af" padding="28px 40px 24px" border-radius="10px 10px 0 0">
      <mj-column>
        {{#if logoUrl}}
        <mj-image src="{{logoUrl}}" alt="{{companyName}}" width="120px" padding="0 0 16px 0" align="center" />
        {{/if}}
        <mj-text align="center" font-size="24px" font-weight="700" color="#ffffff" padding="0 0 6px 0">
          Welcome aboard, {{firstName}}! 🎉
        </mj-text>
        <mj-text align="center" font-size="14px" color="#bfdbfe" padding="0">
          We're excited to have you join <strong style="color:#ffffff;">{{companyName}}</strong>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Greeting -->
    <mj-section background-color="#ffffff" padding="28px 40px 20px">
      <mj-column>
        <mj-text font-size="16px" color="#111827" padding="0 0 10px 0">Hi {{firstName}},</mj-text>
        <mj-text padding="0" color="#374151">
          Congratulations and welcome to the <strong>{{companyName}}</strong> family!
          We're delighted to have you joining us as <strong>{{role}}</strong>.
          Below you'll find everything you need to know before your first day.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- ── Section: Your Profile ── -->
    <mj-section background-color="#ffffff" padding="0 40px 0">
      <mj-column>
        <mj-table>
          <!-- Section header -->
          <tr>
            <td colspan="2" style="padding: 10px 16px 8px; background-color: #eff6ff; border-radius: 6px 6px 0 0; border-left: 3px solid #1e40af;">
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #1e40af;">Your Profile</span>
            </td>
          </tr>
          <!-- Full Name -->
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280; width: 38%;">Full Name</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #111827;">{{firstName}} {{lastName}}</td>
          </tr>
          <!-- Work Email -->
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280;">Work Email</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #1e40af;">{{workEmail}}</td>
          </tr>
          <!-- Employee ID -->
          {{#if employeeId}}
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280;">Employee ID</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #111827;">{{employeeId}}</td>
          </tr>
          {{/if}}
          <!-- Personal Email -->
          {{#if personalEmail}}
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280;">Personal Email</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #111827;">{{personalEmail}}</td>
          </tr>
          {{/if}}
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- ── Section: Your Role ── -->
    <mj-section background-color="#ffffff" padding="16px 40px 0">
      <mj-column>
        <mj-table>
          <tr>
            <td colspan="2" style="padding: 10px 16px 8px; background-color: #eff6ff; border-radius: 6px 6px 0 0; border-left: 3px solid #1e40af;">
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #1e40af;">Your Role</span>
            </td>
          </tr>
          <!-- Job Title -->
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280; width: 38%;">Job Title</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #111827;">{{role}}</td>
          </tr>
          <!-- Department -->
          {{#if department}}
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280;">Department</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #111827;">{{department}}</td>
          </tr>
          {{/if}}
          <!-- Team -->
          {{#if team}}
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280;">Team</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #111827;">{{team}}</td>
          </tr>
          {{/if}}
          <!-- Manager -->
          {{#if managerName}}
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280;">Reporting To</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #111827;">{{managerName}}</td>
          </tr>
          {{/if}}
          <!-- Work Location -->
          {{#if workLocation}}
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280;">Work Location</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #111827;">{{workLocation}}</td>
          </tr>
          {{/if}}
          <!-- Previous Experience -->
          {{#if previousExperience}}
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280;">Prior Experience</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #111827;">{{previousExperience}}</td>
          </tr>
          {{/if}}
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- ── Section: Employment Details ── -->
    <mj-section background-color="#ffffff" padding="16px 40px 0">
      <mj-column>
        <mj-table>
          <tr>
            <td colspan="2" style="padding: 10px 16px 8px; background-color: #eff6ff; border-radius: 6px 6px 0 0; border-left: 3px solid #1e40af;">
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #1e40af;">Employment Details</span>
            </td>
          </tr>
          <!-- Start Date -->
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280; width: 38%;">Start Date</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 600; color: #1e40af;">{{startDate}}</td>
          </tr>
          <!-- Employment Type -->
          {{#if employmentType}}
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280;">Employment Type</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #111827;">{{employmentType}}</td>
          </tr>
          {{/if}}
          <!-- Working Hours -->
          {{#if workingHours}}
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280;">Working Hours</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #111827;">{{workingHours}}</td>
          </tr>
          {{/if}}
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- ── Section: First Day Info ── -->
    <mj-section background-color="#ffffff" padding="16px 40px 0">
      <mj-column>
        <mj-table>
          <tr>
            <td colspan="2" style="padding: 10px 16px 8px; background-color: #eff6ff; border-radius: 6px 6px 0 0; border-left: 3px solid #1e40af;">
              <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: #1e40af;">First Day Info</span>
            </td>
          </tr>
          <!-- Reporting Location -->
          {{#if reportingLocation}}
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280; width: 38%;">Report To</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #111827;">{{reportingLocation}}</td>
          </tr>
          {{/if}}
          <!-- Reporting Time -->
          {{#if reportingTime}}
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280;">Reporting Time</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #111827;">{{reportingTime}}</td>
          </tr>
          {{/if}}
          <!-- HR Contact -->
          {{#if hrEmail}}
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280;">HR Contact</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #1e40af;">{{hrEmail}}</td>
          </tr>
          {{/if}}
          <!-- IT Setup -->
          {{#if itSetupLink}}
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 11px 16px; font-size: 13px; color: #6b7280;">IT Setup Guide</td>
            <td style="padding: 11px 16px; font-size: 14px; font-weight: 500; color: #111827;"><a href="{{itSetupLink}}" style="color: #1e40af;">View setup guide →</a></td>
          </tr>
          {{/if}}
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Note / custom message -->
    {{#if onboardingNote}}
    <mj-section background-color="#ffffff" padding="20px 40px 0">
      <mj-column background-color="#f8fafc" border-radius="6px" border-left="3px solid #6366f1" padding="14px 18px">
        <mj-text font-size="14px" color="#374151" padding="0">
          <strong style="color:#6366f1;">📌 Note from HR</strong><br />{{onboardingNote}}
        </mj-text>
      </mj-column>
    </mj-section>
    {{/if}}

    <!-- CTA -->
    <mj-section background-color="#ffffff" padding="24px 40px 32px">
      <mj-column>
        {{#if portalLink}}
        <mj-button background-color="#1e40af" color="#ffffff" href="{{portalLink}}" align="center">
          Access Your Onboarding Portal
        </mj-button>
        {{/if}}
        <mj-text align="center" font-size="13px" color="#9ca3af" padding="12px 0 0 0">
          Questions? Reply to this email or reach out to
          {{#if hrEmail}}<a href="mailto:{{hrEmail}}" style="color:#1e40af;">{{hrEmail}}</a>{{else}}your HR team{{/if}}.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#1e293b" border-radius="0 0 10px 10px" padding="20px 40px">
      <mj-column>
        <mj-text font-size="12px" color="#64748b" align="center" padding="0">
          © {{companyName}} · This email contains confidential employment information.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 0 28px 0">
      <mj-column><mj-spacer height="4px" /></mj-column>
    </mj-section>

  </mj-body>
</mjml>
