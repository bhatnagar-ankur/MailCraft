<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Inter', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#374151" padding="0 0 12px 0" />
      <mj-button font-size="15px" font-weight="600" border-radius="6px" inner-padding="12px 24px" />
    </mj-attributes>
    <mj-preview>Action required — your account needs attention</mj-preview>
  </mj-head>
  <mj-body background-color="#f3f4f6">

    <mj-section padding="24px 0 0 0">
      <mj-column><mj-spacer height="4px" /></mj-column>
    </mj-section>

    <!-- Warning header bar — uses bgcolor attribute, Outlook-safe -->
    <mj-section background-color="#b91c1c" padding="20px 40px" border-radius="8px 8px 0 0">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="700" color="#ffffff" padding="0">
          ⚠ Account Warning
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Greeting -->
    <mj-section background-color="#ffffff" padding="28px 40px 16px">
      <mj-column>
        <mj-text font-size="17px" color="#111827" padding="0 0 8px 0">Hi {{firstName}},</mj-text>
        <mj-text padding="0">
          We're reaching out about your account. <strong>{{reason}}</strong>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Required action box — uses border attribute on td, Outlook-safe -->
    <mj-section background-color="#fff7ed" padding="0 40px 16px">
      <mj-column border="2px solid #fed7aa" border-radius="6px" padding="16px">
        <mj-text font-size="13px" font-weight="700" color="#c2410c" padding="0 0 6px 0">ACTION REQUIRED</mj-text>
        <mj-text font-size="15px" color="#374151" padding="0">{{actionRequired}}</mj-text>
        {{#if deadline}}
        <mj-text font-size="13px" color="#b45309" padding="8px 0 0 0">
          <strong>Deadline: {{deadline}}</strong>
        </mj-text>
        {{/if}}
      </mj-column>
    </mj-section>

    <!-- CTAs -->
    <mj-section background-color="#ffffff" padding="0 40px 16px">
      <mj-column>
        <mj-button background-color="#b91c1c" color="#ffffff" href="{{supportLink}}" align="center">
          Contact Support
        </mj-button>
      </mj-column>
      {{#if appealLink}}
      <mj-column>
        <mj-button background-color="#ffffff" color="#374151" href="{{appealLink}}" align="center" border="1px solid #d1d5db">
          Submit an Appeal
        </mj-button>
      </mj-column>
      {{/if}}
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f9fafb" border-radius="0 0 8px 8px" padding="20px 40px">
      <mj-column>
        <mj-text font-size="13px" color="#9ca3af" align="center" padding="0">
          Please respond before the deadline to avoid account suspension.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 0 24px 0">
      <mj-column><mj-spacer height="4px" /></mj-column>
    </mj-section>

  </mj-body>
</mjml>
