<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Inter', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#374151" padding="0 0 12px 0" />
      <mj-button font-size="15px" font-weight="600" border-radius="6px" inner-padding="12px 24px" />
    </mj-attributes>
    <mj-preview>Invoice {{invoiceNumber}} — {{currency}} {{total}}</mj-preview>
  </mj-head>
  <mj-body background-color="#f3f4f6">

    <mj-section padding="24px 0 0 0">
      <mj-column><mj-spacer height="4px" /></mj-column>
    </mj-section>

    <!-- Header -->
    <mj-section background-color="#1f2937" padding="28px 40px" border-radius="8px 8px 0 0">
      <mj-column>
        <mj-text align="left" font-size="22px" font-weight="700" color="#ffffff" padding="0">
          Invoice
        </mj-text>
        <mj-text align="left" font-size="14px" color="#9ca3af" padding="4px 0 0 0">
          {{invoiceNumber}}
        </mj-text>
      </mj-column>
      <mj-column>
        <mj-text align="right" font-size="13px" color="#d1d5db" padding="0">
          Date: {{invoiceDate}}{{#if dueDate}}<br />Due: {{dueDate}}{{/if}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Bill To -->
    <mj-section background-color="#ffffff" padding="24px 40px 0">
      <mj-column>
        <mj-text font-size="11px" font-weight="700" color="#6b7280" padding="0 0 4px 0">BILL TO</mj-text>
        <mj-text font-size="17px" font-weight="600" color="#111827" padding="0">{{customerName}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- Line items table -->
    <mj-section background-color="#ffffff" padding="16px 40px 0">
      <mj-column>
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
            <tr style="background-color:#f8fafc;">
              <td style="padding:10px 12px;font-size:12px;font-weight:700;color:#6b7280;text-transform:uppercase;border-bottom:1px solid #e5e7eb;">Description</td>
              <td style="padding:10px 12px;font-size:12px;font-weight:700;color:#6b7280;text-transform:uppercase;border-bottom:1px solid #e5e7eb;text-align:center;">Qty</td>
              <td style="padding:10px 12px;font-size:12px;font-weight:700;color:#6b7280;text-transform:uppercase;border-bottom:1px solid #e5e7eb;text-align:right;">Unit Price</td>
              <td style="padding:10px 12px;font-size:12px;font-weight:700;color:#6b7280;text-transform:uppercase;border-bottom:1px solid #e5e7eb;text-align:right;">Total</td>
            </tr>
            {{#each items}}
            <tr>
              <td style="padding:12px;font-size:15px;color:#374151;border-bottom:1px solid #f3f4f6;">{{description}}</td>
              <td style="padding:12px;font-size:15px;color:#374151;border-bottom:1px solid #f3f4f6;text-align:center;">{{quantity}}</td>
              <td style="padding:12px;font-size:15px;color:#374151;border-bottom:1px solid #f3f4f6;text-align:right;">{{unitPrice}}</td>
              <td style="padding:12px;font-size:15px;color:#111827;font-weight:500;border-bottom:1px solid #f3f4f6;text-align:right;">{{total}}</td>
            </tr>
            {{/each}}
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Totals -->
    <mj-section background-color="#ffffff" padding="0 40px 24px">
      <mj-column width="60%">
        <mj-spacer height="8px" />
      </mj-column>
      <mj-column width="40%">
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="padding:6px 0;font-size:14px;color:#6b7280;">Subtotal</td>
              <td style="padding:6px 0;font-size:14px;color:#374151;text-align:right;">{{currency}} {{subtotal}}</td>
            </tr>
            {{#if tax}}
            <tr>
              <td style="padding:6px 0;font-size:14px;color:#6b7280;">Tax</td>
              <td style="padding:6px 0;font-size:14px;color:#374151;text-align:right;">{{currency}} {{tax}}</td>
            </tr>
            {{/if}}
            <tr>
              <td style="padding:10px 0 0;font-size:18px;font-weight:700;color:#111827;border-top:2px solid #111827;">Total</td>
              <td style="padding:10px 0 0;font-size:18px;font-weight:700;color:#111827;border-top:2px solid #111827;text-align:right;">{{currency}} {{total}}</td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Download CTA -->
    {{#if downloadLink}}
    <mj-section background-color="#ffffff" padding="0 40px 32px">
      <mj-column>
        <mj-button background-color="#1f2937" color="#ffffff" href="{{downloadLink}}" align="center">
          Download PDF Invoice
        </mj-button>
      </mj-column>
    </mj-section>
    {{/if}}

    <!-- Footer -->
    <mj-section background-color="#f9fafb" border-radius="0 0 8px 8px" padding="20px 40px">
      <mj-column>
        <mj-text font-size="13px" color="#9ca3af" align="center" padding="0">
          Thank you for your business.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 0 24px 0">
      <mj-column><mj-spacer height="4px" /></mj-column>
    </mj-section>

  </mj-body>
</mjml>
