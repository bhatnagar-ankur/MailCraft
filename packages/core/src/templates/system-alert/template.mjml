<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Inter', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#374151" padding="0 0 12px 0" />
      <mj-button font-size="15px" font-weight="600" border-radius="6px" inner-padding="12px 24px" />
    </mj-attributes>
    <mj-preview>{{alertTitle}}</mj-preview>
  </mj-head>
  <mj-body background-color="#f3f4f6">

    <mj-section padding="24px 0 0 0">
      <mj-column><mj-spacer height="4px" /></mj-column>
    </mj-section>

    <!-- Alert header — bgcolor on td (Outlook-safe, no CSS class-based background) -->
    {{#if (eq alertType "critical")}}
    <mj-section background-color="#dc2626" padding="20px 40px" border-radius="8px 8px 0 0">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="700" color="#ffffff" padding="0">
          ⚠ Critical Alert
        </mj-text>
      </mj-column>
    </mj-section>
    {{/if}}
    {{#if (eq alertType "warning")}}
    <mj-section background-color="#d97706" padding="20px 40px" border-radius="8px 8px 0 0">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="700" color="#ffffff" padding="0">
          ⚡ Warning
        </mj-text>
      </mj-column>
    </mj-section>
    {{/if}}
    {{#if (eq alertType "info")}}
    <mj-section background-color="#2563eb" padding="20px 40px" border-radius="8px 8px 0 0">
      <mj-column>
        <mj-text align="center" font-size="18px" font-weight="700" color="#ffffff" padding="0">
          ℹ Info
        </mj-text>
      </mj-column>
    </mj-section>
    {{/if}}

    <!-- Body -->
    <mj-section background-color="#ffffff" padding="28px 40px 16px">
      <mj-column>
        <mj-text font-size="17px" color="#111827" padding="0 0 8px 0">Hi {{firstName}},</mj-text>
        <mj-text font-size="18px" font-weight="700" color="#111827" padding="0 0 8px 0">{{alertTitle}}</mj-text>
        <mj-text padding="0">{{alertMessage}}</mj-text>
        <mj-text font-size="13px" color="#9ca3af" padding="0">{{timestamp}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- Optional action -->
    {{#if actionLink}}
    <mj-section background-color="#ffffff" padding="0 40px 24px">
      <mj-column>
        <mj-button background-color="#111827" color="#ffffff" href="{{actionLink}}" align="center">
          {{actionText}}
        </mj-button>
      </mj-column>
    </mj-section>
    {{/if}}

    <!-- Support link -->
    {{#if supportLink}}
    <mj-section background-color="#ffffff" padding="0 40px 24px">
      <mj-column>
        <mj-text font-size="13px" color="#6b7280" align="center" padding="0">
          Need help? <a href="{{supportLink}}" style="color:#2563eb;">Contact support</a>
        </mj-text>
      </mj-column>
    </mj-section>
    {{/if}}

    <!-- Footer -->
    <mj-section background-color="#f9fafb" border-radius="0 0 8px 8px" padding="20px 40px">
      <mj-column>
        <mj-text font-size="13px" color="#9ca3af" align="center" padding="0">
          This is an automated notification. Do not reply to this email.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 0 24px 0">
      <mj-column><mj-spacer height="4px" /></mj-column>
    </mj-section>

  </mj-body>
</mjml>
