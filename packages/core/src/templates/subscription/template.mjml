<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Inter', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#374151" padding="0 0 12px 0" />
      <mj-button font-size="15px" font-weight="600" border-radius="6px" inner-padding="12px 24px" />
    </mj-attributes>
    <mj-preview>Your {{planName}} plan is now active — welcome aboard!</mj-preview>
  </mj-head>
  <mj-body background-color="#f3f4f6">

    <mj-section padding="24px 0 0 0">
      <mj-column><mj-spacer height="4px" /></mj-column>
    </mj-section>

    <!-- Header -->
    <mj-section background-color="#7c3aed" padding="28px 40px" border-radius="8px 8px 0 0">
      <mj-column>
        <mj-text align="center" font-size="20px" font-weight="700" color="#ffffff" padding="0">
          You're on the {{planName}} Plan 🚀
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Greeting -->
    <mj-section background-color="#ffffff" padding="28px 40px 16px">
      <mj-column>
        <mj-text font-size="17px" color="#111827" padding="0 0 8px 0">Hi {{firstName}},</mj-text>
        <mj-text padding="0">
          Your <strong>{{planName}}</strong> subscription is now active from <strong>{{startDate}}</strong>.
          {{#if nextBillingDate}}Your next billing date is <strong>{{nextBillingDate}}</strong>.{{/if}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Plan card with features -->
    {{#if featuresIncluded}}
    <mj-section background-color="#faf5ff" padding="0 40px 16px">
      <mj-column border="1px solid #ddd6fe" border-radius="8px" padding="20px">
        <mj-text font-size="15px" font-weight="700" color="#5b21b6" padding="0 0 12px 0">
          What's included in your plan:
        </mj-text>
        <mj-text font-size="14px" color="#374151" padding="0">
          <ul style="margin:0;padding-left:20px;">
            {{#each featuresIncluded}}
            <li style="margin-bottom:6px;">{{this}}</li>
            {{/each}}
          </ul>
        </mj-text>
      </mj-column>
    </mj-section>
    {{/if}}

    <!-- Billing info -->
    {{#if amount}}
    <mj-section background-color="#ffffff" padding="0 40px 16px">
      <mj-column>
        <mj-text font-size="13px" color="#6b7280" padding="0">
          Amount charged: <strong>{{currency}} {{amount}}</strong>
          {{#if nextBillingDate}}· Next billing: <strong>{{nextBillingDate}}</strong>{{/if}}
        </mj-text>
      </mj-column>
    </mj-section>
    {{/if}}

    <!-- CTA -->
    <mj-section background-color="#ffffff" padding="0 40px 32px">
      <mj-column>
        <mj-button background-color="#7c3aed" color="#ffffff" href="{{manageLink}}" align="center">
          Manage Subscription
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#f9fafb" border-radius="0 0 8px 8px" padding="20px 40px">
      <mj-column>
        <mj-text font-size="13px" color="#9ca3af" align="center" padding="0">
          You can manage or cancel your subscription at any time.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 0 24px 0">
      <mj-column><mj-spacer height="4px" /></mj-column>
    </mj-section>

  </mj-body>
</mjml>
