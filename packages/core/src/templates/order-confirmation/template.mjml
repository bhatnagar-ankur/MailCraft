<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="'Inter', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#374151" padding="0 0 12px 0" />
      <mj-button font-size="15px" font-weight="600" border-radius="6px" inner-padding="12px 24px" />
    </mj-attributes>
    <mj-preview>Order {{orderNumber}} confirmed — estimated delivery {{estimatedDelivery}}</mj-preview>
  </mj-head>
  <mj-body background-color="#f3f4f6">

    <mj-section padding="24px 0 0 0">
      <mj-column><mj-spacer height="4px" /></mj-column>
    </mj-section>

    <!-- Header -->
    <mj-section background-color="#065f46" padding="28px 40px" border-radius="8px 8px 0 0">
      <mj-column>
        <mj-text align="center" font-size="20px" font-weight="700" color="#ffffff" padding="0">
          Order Confirmed ✓
        </mj-text>
        <mj-text align="center" font-size="14px" color="#a7f3d0" padding="4px 0 0 0">
          Order {{orderNumber}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Greeting & delivery estimate -->
    <mj-section background-color="#ffffff" padding="28px 40px 16px">
      <mj-column>
        <mj-text font-size="17px" color="#111827" padding="0 0 8px 0">Hi {{customerName}},</mj-text>
        <mj-text padding="0">
          Your order is confirmed and being processed. Estimated delivery:
          <strong>{{estimatedDelivery}}</strong>.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Product list -->
    <mj-section background-color="#ffffff" padding="0 40px 16px">
      <mj-column>
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;border-top:1px solid #e5e7eb;">
            {{#each items}}
            <tr>
              <td width="72" style="padding:12px 12px 12px 0;border-bottom:1px solid #f3f4f6;vertical-align:top;">
                <img src="{{imageUrl}}" width="64" height="64" alt="{{name}}" style="border-radius:6px;display:block;" />
              </td>
              <td style="padding:12px 0;border-bottom:1px solid #f3f4f6;vertical-align:top;">
                <p style="margin:0;font-size:15px;font-weight:600;color:#111827;">{{name}}</p>
                <p style="margin:4px 0 0;font-size:13px;color:#6b7280;">Qty: {{quantity}}</p>
              </td>
              <td style="padding:12px 0;border-bottom:1px solid #f3f4f6;vertical-align:top;text-align:right;">
                <p style="margin:0;font-size:15px;font-weight:600;color:#111827;">{{price}}</p>
              </td>
            </tr>
            {{/each}}
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Order summary -->
    <mj-section background-color="#f8fafc" padding="0 40px 16px">
      <mj-column border="1px solid #e5e7eb" border-radius="6px" padding="16px">
        <mj-text padding="0">
          <table width="100%" cellpadding="0" cellspacing="0" border="0">
            <tr>
              <td style="padding:4px 0;font-size:14px;color:#6b7280;">Subtotal</td>
              <td style="padding:4px 0;font-size:14px;color:#374151;text-align:right;">{{subtotal}}</td>
            </tr>
            <tr>
              <td style="padding:4px 0;font-size:14px;color:#6b7280;">Shipping</td>
              <td style="padding:4px 0;font-size:14px;color:#374151;text-align:right;">{{shipping}}</td>
            </tr>
            <tr>
              <td style="padding:8px 0 0;font-size:16px;font-weight:700;color:#111827;border-top:1px solid #e5e7eb;">Total</td>
              <td style="padding:8px 0 0;font-size:16px;font-weight:700;color:#111827;border-top:1px solid #e5e7eb;text-align:right;">{{total}}</td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Delivery address -->
    <mj-section background-color="#ffffff" padding="0 40px 24px">
      <mj-column>
        <mj-text font-size="12px" font-weight="700" color="#6b7280" padding="0 0 4px 0">DELIVERY ADDRESS</mj-text>
        <mj-text font-size="14px" color="#374151" padding="0">{{deliveryAddress}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- Track CTA -->
    {{#if trackingLink}}
    <mj-section background-color="#ffffff" padding="0 40px 32px">
      <mj-column>
        <mj-button background-color="#065f46" color="#ffffff" href="{{trackingLink}}" align="center">
          Track Your Order
        </mj-button>
      </mj-column>
    </mj-section>
    {{/if}}

    <!-- Footer -->
    <mj-section background-color="#f9fafb" border-radius="0 0 8px 8px" padding="20px 40px">
      <mj-column>
        <mj-text font-size="13px" color="#9ca3af" align="center" padding="0">
          Thank you for your order!
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 0 24px 0">
      <mj-column><mj-spacer height="4px" /></mj-column>
    </mj-section>

  </mj-body>
</mjml>
